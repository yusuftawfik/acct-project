# Copy to .env and fill in. Never commit .env.
# The server reads these as environment variables (it does not load .env by itself;
# set them in your terminal or hosting dashboard).

# Protects writes (POST/PUT/DELETE and report refresh). Empty = open, development only.
# Always set this when hosting.
CIC_API_KEY=

# First day of the financial year (YYYY-MM-DD)
CIC_FY_START=2026-07-01

# Income tax rate as a decimal (22.5% = 0.225)
CIC_TAX_RATE=0.225

# API port
PORT=5000

# Full path to the Excel model used by the PDF export scripts
EXCEL_PATH=C:\Users\HP\Desktop\journal-project\excel\CIC_Financial_Model_v2.xlsx

# "live" = run Excel to refresh and export PDFs (Windows + desktop Excel only)
# "static" = never run Excel; serve whatever PDFs are already in excel/exports
EXCEL_EXPORT_MODE=live
